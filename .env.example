# ProcureRPA Enterprise local development settings.
# Set every blank secret before starting Compose. Do not commit the resulting .env.

ENV=local
LOG_LEVEL=INFO
PORT=8000
SKYVERN_TELEMETRY=false

# Host-side connections. Docker Compose injects its own service hostnames.
POSTGRES_PASSWORD=
DATABASE_STRING=postgresql+asyncpg://skyvern:${POSTGRES_PASSWORD}@localhost:15432/skyvern
REDIS_URL=redis://localhost:16379/0

# Required by the existing enterprise JWT bridge. Generate locally, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SIGNATURE_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Private procurement audit artifacts and quote PDF files.
MINIO_ENDPOINT=localhost:19000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_USE_SSL=false

# The service starts without an LLM; enable one provider before running browser tasks.
LLM_KEY=OPENAI_GPT4O
# Optional registry keys for procurement routing; unset tiers use LLM_KEY.
PROCUREMENT_LIGHT_LLM_KEY=
PROCUREMENT_STANDARD_LLM_KEY=
PROCUREMENT_HEAVY_LLM_KEY=
ENABLE_OPENAI=false
OPENAI_API_KEY=
ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=
ENABLE_GEMINI=false
GEMINI_API_KEY=

BROWSER_TYPE=chromium-headless
MAX_STEPS_PER_RUN=10
SKYVERN_STORAGE_TYPE=local
ARTIFACT_STORAGE_PATH=./artifacts
PROCUREMENT_SMOKE_ALLOWED_URLS=https://example.com/,http://host.docker.internal:18080/procurement/vendor-a.html,http://host.docker.internal:18080/procurement/vendor-b.html

# Optional procurement approval group robots. Keep real webhook tokens only in .env.
PROCUREMENT_APPROVAL_URL=http://localhost:18080/enterprise/approvals
WECOM_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=

# Frontend development.
VITE_API_BASE_URL=http://localhost:18000/api/v1
VITE_WSS_BASE_URL=ws://localhost:18000/api/v1
VITE_ARTIFACT_API_BASE_URL=http://localhost:18000
VITE_SKYVERN_API_KEY=
